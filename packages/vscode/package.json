{
	"name": "@pls/vscode",
	"displayName": "PLS - PHP Language Server",
	"description": "PHP Language Server extension for VS Code",
	"version": "0.1.0",
	"publisher": "leocavalcante",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": ["Programming Languages"],
	"activationEvents": ["onLanguage:php"],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "PLS",
			"properties": {
				"pls.serverPath": {
					"type": "string",
					"default": "pls",
					"description": "Path to the PLS executable"
				}
			}
		}
	},
	"scripts": {
		"build": "bun build extension.ts --outdir dist --target node --external vscode",
		"watch": "bun build extension.ts --outdir dist --target node --external vscode --watch"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0"
	}
}
